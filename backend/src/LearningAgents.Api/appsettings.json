{
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=learning-agents.db"
  },
  "Gemini": {
    "DefaultModel": "gemini-3.8-flash",
    "FallbackModel": "gemini-3.5-flash-lite"
  },
  "LlmProfiles": {
    "DefaultProfile": "gemini-default",
    "Profiles": {
      "gemini-default": {
        "Provider": "gemini",
        "Model": "gemini-3.8-flash",
        "FallbackProfiles": ["gemini-3.5-flash-lite", "gemini-3.1-flash-lite"]
      },
      "gemini-3.8-flash": {
        "Provider": "gemini",
        "Model": "gemini-3.8-flash",
        "FallbackProfiles": ["gemini-3.5-flash-lite", "gemini-3.1-flash-lite"]
      },
      "gemini-3.5-flash-lite": {
        "Provider": "gemini",
        "Model": "gemini-3.5-flash-lite",
        "FallbackProfiles": ["gemini-3.1-flash-lite", "gemini-3.8-flash"]
      },
      "gemini-3.1-flash-lite": {
        "Provider": "gemini",
        "Model": "gemini-3.1-flash-lite",
        "FallbackProfiles": ["gemini-3.5-flash-lite", "gemini-3.8-flash"]
      },
      "groq-qwen-32b": {
        "Provider": "groq",
        "Model": "qwen/qwen3-32b",
        "FallbackProfiles": ["gemini-3.5-flash-lite"]
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
