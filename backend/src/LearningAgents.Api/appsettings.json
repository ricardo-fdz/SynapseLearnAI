{
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=learning-agents.db"
  },
  "LlmProfiles": {
    "DefaultProfile": "gemini-3.1-flash-lite",
    "Profiles": {
      "gemini-default": {
        "Provider": "gemini",
        "Model": "gemini-2.5-flash",
        "FallbackProfiles": ["gemini-2.0-flash"]
      },
      "gemini-2.0-flash": {
        "Provider": "gemini",
        "Model": "gemini-2.0-flash",
        "FallbackProfiles": ["groq-qwen-32b"]
      },
      "gemini-3.1-flash-lite": {
        "Provider": "gemini",
        "Model": "gemini-3.1-flash-lite",
        "FallbackProfiles": ["gemini-default"]
      },
      "groq-qwen-32b": {
        "Provider": "groq",
        "Model": "qwen/qwen3-32b",
        "FallbackProfiles": []
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
